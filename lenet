# -*- coding: utf-8 -*-
"""
LeNet-5 训练 CIFAR-10（精简版：无 d2l、纯 CPU、内置函数直写）
数据集：D:\datasets\cifar10（已就位于本地，无需下载）
运行：python CNN_lenet_5.py
"""

import time
import torch
from torch import nn
from torch.utils import data
import torchvision
from torchvision import transforms

# ---------- 1. 数据加载（仅保留加载与格式转换） ----------
class LocalCIFAR10(torchvision.datasets.CIFAR10):
    """跳过官方 MD5 校验（本地转储文件字节与官方不同，数据内容一致），只查文件是否存在"""
    def _check_integrity(self):
        import os
        return all(os.path.isfile(os.path.join(self.root, self.base_folder, f))
                   for f, _ in (self.train_list + self.test_list))

    def _load_meta(self):
        import os, pickle
        with open(os.path.join(self.root, self.base_folder, self.meta["filename"]), "rb") as f:
            self.classes = pickle.load(f, encoding="latin1")[self.meta["key"]]

trans = transforms.Compose([
    transforms.ToTensor(),    # HWC->CHW，像素 [0,255]->[0,1]
    transforms.Normalize((0.4914, 0.4822, 0.4465), (0.2470, 0.2435, 0.2616)),  # 按数据集均值/方差标准化，加速收敛
])
train_set = LocalCIFAR10(root=r"D:\datasets\cifar10", train=True, transform=trans, download=False)   # 50000 张
test_set = LocalCIFAR10(root=r"D:\datasets\cifar10", train=False, transform=trans, download=False)   # 10000 张
batch_size = 256
train_iter = data.DataLoader(train_set, batch_size, shuffle=True)
test_iter = data.DataLoader(test_set, batch_size, shuffle=False)

# ---------- 2. 模型搭建（LeNet-5） ----------
# 输入 (3,32,32)；首层 padding=2 保持 32x32，两次池化后为 16x6x6，与 16*6*6=576 对应
net = nn.Sequential(
    nn.Conv2d(3, 6, kernel_size=5, padding=2), nn.ReLU(),      # C1: 3->6,  32x32
    nn.AvgPool2d(kernel_size=2, stride=2),                     # S2: 6,     16x16
    nn.Conv2d(6, 16, kernel_size=5),           nn.ReLU(),      # C3: 6->16, 12x12
    nn.AvgPool2d(kernel_size=2, stride=2),                     # S4: 16,    6x6
    nn.Flatten(),                                              # 展平成 576 维
    nn.Linear(16 * 5*5, 120),    nn.ReLU(),                  # F5: 576->120
    nn.Linear(120, 84),            nn.ReLU(),                  # F6: 120->84
    nn.Linear(84, 10))                                         # 输出: 84->10 类

def init_weights(m):                       # Xavier 初始化，稳定训练初期梯度
        if type(m) == nn.Linear or type(m) == nn.Conv2d:
            nn.init.xavier_uniform_(m.weight)

# ---------- 3. 训练 + 评估（训练循环中直接统计，epoch 末在测试集上评估） ----------
lr, num_epochs = 0.1, 10
optimizer = torch.optim.SGD(net.parameters(), lr=lr)   # 随机梯度下降
loss = nn.CrossEntropyLoss()                           # 交叉熵损失（内含 Softmax）

for epoch in range(num_epochs):
    net.train()
    total_loss, correct, total = 0.0, 0, 0             # 用普通变量累加
    t0 = time.time()
    for X, y in train_iter:
        optimizer.zero_grad()
        y_hat = net(X)
        l = loss(y_hat, y)
        l.backward()
        optimizer.step()
        with torch.no_grad():
            total_loss += l * X.shape[0]
            correct += (y_hat.argmax(1) == y).sum().item()
            total += X.shape[0]

    net.eval()                                         # 在测试集上评估
    test_correct, test_total = 0, 0
    with torch.no_grad():
        for X, y in test_iter:
            test_correct += (net(X).argmax(1) == y).sum().item()
            test_total += y.numel()

    print(f'epoch {epoch+1}/{num_epochs}: '
          f'train loss {total_loss/total:.3f}, '
          f'train acc {correct/total:.3f}, '
          f'test acc {test_correct/test_total:.3f}, '
          f'{total/(time.time()-t0):.0f} img/s')
    
