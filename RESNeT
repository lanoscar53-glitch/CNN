# -*- coding: utf-8 -*-
"""
ResNet-18 训练 CIFAR-10（CIFAR 适配版：3x3 卷积起步、无初始 MaxPool，精简风格）
数据集：本地 D 盘 或 服务器自动下载（修改 root 与 download 即可）
运行：python resnet18_cifar10.py
"""

import time
import torch
from torch import nn
from torch.utils import data
import torchvision
from torchvision import transforms

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')   # 有GPU用GPU，否则CPU

# ---------- 1. 数据加载（仅保留加载与格式转换） ----------
class LocalCIFAR10(torchvision.datasets.CIFAR10):
    """跳过官方 MD5 校验（本地转储文件字节与官方不同，数据内容一致），只查文件是否存在"""
    def _check_integrity(self):
        import os
        return all(os.path.isfile(os.path.join(self.root, self.base_folder, f))
                   for f, _ in (self.train_list + self.test_list))

    def _load_meta(self):
        import os, pickle
        with open(os.path.join(self.root, self.base_folder, self.meta["filename"]), "rb") as f:
            self.classes = pickle.load(f, encoding="latin1")[self.meta["key"]]

trans = transforms.Compose([
    transforms.ToTensor(),    # HWC->CHW，像素 [0,255]->[0,1]
    transforms.Normalize((0.4914, 0.4822, 0.4465), (0.2470, 0.2435, 0.2616)),  # 按数据集均值/方差标准化
])
# 本地数据：root=r"D:\datasets\cifar10", download=False
# 云服务器：root="./data", download=True（服务器带宽快，秒下）
train_set = LocalCIFAR10(root=r"D:\datasets\cifar10", train=True, transform=trans, download=False)   # 50000 张
test_set = LocalCIFAR10(root=r"D:\datasets\cifar10", train=False, transform=trans, download=False)   # 10000 张
batch_size = 512
train_iter = data.DataLoader(train_set, batch_size, shuffle=True,
                             pin_memory=device.type == 'cuda')
test_iter = data.DataLoader(test_set, batch_size, shuffle=False,
                            pin_memory=device.type == 'cuda')

# ---------- 2. 模型搭建（ResNet-18，CIFAR 32x32 输入版） ----------
# 形状链: 32 -> 32 -> 32 -> 32 -> 16 -> 16 -> 8 -> 8 -> 4 -> 1x1 -> 512 -> 10
# 4个stage各2个残差块: 64, 64 | 128, 128 | 256, 256 | 512, 512
class Block(nn.Module):
    """残差块：两层卷积 + 跳跃连接。stride=2 时缩小一半，shortcut 用 1x1 卷积对齐形状"""
    def __init__(self, c1, c2, stride=1):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(c1, c2, 3, stride, 1, bias=False), nn.BatchNorm2d(c2), nn.ReLU(inplace=True),
            nn.Conv2d(c2, c2, 3, 1, 1, bias=False), nn.BatchNorm2d(c2))
        self.short = nn.Identity() if (c1 == c2 and stride == 1) else nn.Sequential(
            nn.Conv2d(c1, c2, 1, stride, bias=False), nn.BatchNorm2d(c2))

    def forward(self, x):
        return torch.relu(self.conv(x) + self.short(x))      # 关键：跨层加法 F(x) + x

net = nn.Sequential(
    nn.Conv2d(3, 64, 3, 1, 1, bias=False), nn.BatchNorm2d(64), nn.ReLU(inplace=True),   # 3->64, 32x32
    Block(64, 64),  Block(64, 64),                                                        # stage1: 64, 32x32
    Block(64, 128, 2),  Block(128, 128),                                                  # stage2: 128, 16x16
    Block(128, 256, 2), Block(256, 256),                                                  # stage3: 256, 8x8
    Block(256, 512, 2), Block(512, 512),                                                  # stage4: 512, 4x4
    nn.AdaptiveAvgPool2d(1), nn.Flatten(),                                               # 1x1 -> 512 维
    nn.Linear(512, 10))                                                                   # 输出: 10 类

for m in net.modules():                # Xavier 初始化（net.modules() 能递归进入每个 Block 内部的卷积）
    if isinstance(m, (nn.Linear, nn.Conv2d)):
        nn.init.xavier_uniform_(m.weight)

net = net.to(device)
raw_net = net                          # 保存未 compile 的引用（存权重键名不带 _orig_mod. 前缀）
try:                                   # torch.compile 编译加速（首次编译 1-2 分钟，之后提速 20%-50%）
    net = torch.compile(net)
except Exception:
    pass

# ---------- 3. 训练 + 评估（训练循环中直接统计，epoch 末在测试集上评估，保存最优权重） ----------
lr, num_epochs = 0.1, 20               # 有 BatchNorm 后可以用大学习率；ResNet 通常要 50-100 epoch 才充分收敛
optimizer = torch.optim.SGD(net.parameters(), lr=lr, momentum=0.9)
loss = nn.CrossEntropyLoss()
best_acc = 0.0

print(f'training on {device}，首次迭代会触发编译，请耐心等待...')
for epoch in range(num_epochs):
    net.train()                        # BN 依赖 train/eval 模式：训练时按批统计，评估时用滑动平均
    total_loss, correct, total = 0.0, 0, 0
    t0 = time.time()
    for X, y in train_iter:
        X, y = X.to(device), y.to(device)
        optimizer.zero_grad()
        y_hat = net(X)
        l = loss(y_hat, y)
        l.backward()
        optimizer.step()
        with torch.no_grad():
            total_loss += l * X.shape[0]
            correct += (y_hat.argmax(1) == y).sum().item()
            total += X.shape[0]

    net.eval()
    test_correct, test_total = 0, 0
    with torch.no_grad():
        for X, y in test_iter:
            X, y = X.to(device), y.to(device)
            test_correct += (net(X).argmax(1) == y).sum().item()
            test_total += y.numel()
    test_acc = test_correct / test_total

    print(f'epoch {epoch+1}/{num_epochs}: '
          f'train loss {total_loss/total:.3f}, '
          f'train acc {correct/total:.3f}, '
          f'test acc {test_acc:.3f}, '
          f'{total/(time.time()-t0):.0f} img/s')

    if test_acc > best_acc:                # 测试准确率创新高就保存权重
        best_acc = test_acc
        torch.save(raw_net.state_dict(), 'resnet18_cifar10_best.pth')

print(f'训练完成，最佳 test acc {best_acc:.3f}，权重已保存到 resnet18_cifar10_best.pth') 
